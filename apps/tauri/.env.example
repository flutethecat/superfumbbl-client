# FUMBBL JNLP-free login — SINGLE APPLICATION API CREDENTIAL (owner 2026-07-09)
#
# The client mints its own one-time FUMBBL play token (oauth/token -> auth/getToken)
# instead of downloading ffblive.jnlp. The credential is the APP's own fumbbl.com API
# client — ONE application token used by every install, provisioned here at BUILD TIME
# and OCCLUDED from the settings pane (never stored in localStorage or shown in the UI).
#
# To enable API login in a build:
#   1. Copy this file to `.env` (git-ignored — never commit the real values).
#   2. Paste the application's fumbbl.com API client id/secret below.
#   3. Rebuild. Builds without these fall back to Open .jnlp automatically
#      (fumbblApiConfigured() === false).
#
# Consumed by apps/tauri/src/game/fumbblAuth.ts via import.meta.env.

VITE_FUMBBL_APP_CLIENT_ID=
VITE_FUMBBL_APP_CLIENT_SECRET=
