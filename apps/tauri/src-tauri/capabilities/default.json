{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-set-fullscreen",
    "dialog:allow-open",
    "dialog:allow-save",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "https://fumbbl.com/*" },
        { "url": "http://*:4310/*" },
        { "url": "https://*:4310/*" },
        { "url": "https://superfumbbltest.duckdns.org/*" },
        { "url": "https://api.github.com/*" }
      ]
    },
    "updater:default",
    "process:allow-restart",
    "opener:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "https://*" },
        { "url": "http://*" }
      ]
    }
  ]
}
