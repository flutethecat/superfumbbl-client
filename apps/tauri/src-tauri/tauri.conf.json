{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FUMBBL40k",
  "version": "0.3.20",
  "identifier": "com.fumbbl40k.app",
  "build": {
    "beforeDevCommand": "pnpm dev:vite",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build:vite",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Super FUMBBL",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --autoplay-policy=no-user-gesture-required"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "TABBL / flutethecat",
    "category": "Game",
    "shortDescription": "Spectate live FUMBBL Blood Bowl matches",
    "longDescription": "FUMBBL40k — a modern spectator client for FUMBBL Blood Bowl. Browse and watch live matches (no account needed) with a rebuilt PixiJS pitch, cinematics, and HUD. Alpha release.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": false
  }
}
